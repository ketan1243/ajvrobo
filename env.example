# Aa file ne copy kari ".env" naam aapo ane potani value bharo.
# ".env" ne kyarey GitHub par upload na karvu!
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=0

ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PIN=
ANGEL_TOTP_SECRET=

# Optional: static IP proxy (format: http://user:pass@host:port)
PROXY_URL=

# Optional: Railway Volume vapro to /data set karo (state/history file kayam rahe)
DATA_DIR=

# Admin password: Settings ma Strategy/Timeframe jova mate Telegram ma "/admin <password>" lakho (10 min unlock)
# Khali rakho to koi pan Strategy/Timeframe badli nahi shake
ADMIN_PASSWORD=
